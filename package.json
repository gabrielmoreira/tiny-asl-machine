{
  "name": "tiny-asl-machine",
  "version": "0.0.11",
  "description": "Tiny Amazon State Language machine",
  "author": "Gabriel Moreira",
  "homepage": "https://github.com/gabrielmoreira/tiny-asl-machine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielmoreira/tiny-asl-machine.git"
  },
  "bugs": {
    "url": "https://github.com/gabrielmoreira/tiny-asl-machine/issues"
  },
  "license": "MIT",
  "keywords": [
    "aws",
    "step-functions",
    "state-machine",
    "asl",
    "amazon-states-language",
    "workflow",
    "orchestration",
    "serverless"
  ],
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "lib",
    "skills",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts --suite=all --aws-mode=auto",
    "test:local": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts --suite=all --aws-mode=off",
    "test:aws": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts --suite=all --aws-mode=required",
    "test:conformance": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts --suite=conformance --aws-mode=warn",
    "test:conformance:local": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts --suite=conformance --aws-mode=off",
    "test:conformance:aws": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts --suite=conformance --aws-mode=required",
    "test:watch": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts --suite=all --aws-mode=off --watch",
    "test:ci": "node --max-old-space-size=8192 --experimental-transform-types ./scripts/run-vitest.ts run --suite=all --aws-mode=off",
    "aws:create-deployment-config": "node --experimental-transform-types ./scripts/aws-create-deployment-config.ts",
    "aws:deploy-stack": "node --experimental-transform-types ./scripts/aws-deploy-stack.ts",
    "aws:remove-stack": "node --experimental-transform-types ./scripts/aws-remove-stack.ts",
    "clean": "rimraf ./lib",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsgo -p tsconfig.type-tests.json",
    "lint:staged": "lint-staged",
    "build": "pnpm run -s clean && node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc && node --max-old-space-size=8192 --experimental-transform-types ./scripts/build-package-exports.ts",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "prepare": "pnpm simple-git-hooks"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1030.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1030.0",
    "@aws-sdk/client-iam": "^3.1030.0",
    "@aws-sdk/client-lambda": "^3.1030.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-sfn": "^3.1030.0",
    "@aws-sdk/client-sts": "^3.1030.0",
    "@types/debug": "^4.1.12",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^25.6.0",
    "@types/yazl": "^3.3.0",
    "lint-staged": "^16.3.1",
    "liqe": "^3.8.5",
    "oxfmt": "latest",
    "oxlint": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260415.1",
    "oxlint-tsgolint": "latest",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.9.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "deep-iterator": "^1.1.0",
    "jsonata": "^2.1.0",
    "jsonpath": "^1.1.1",
    "p-limit": "^7.3.0"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:staged"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "engineStrict": true
}
