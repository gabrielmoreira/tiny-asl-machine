  "id": "006-aws-lambda-jsonata-context-observation",
  "title": "projects JSONata $states.input and $states.context through a task callback payload",
  "group": "Task.State",
  "hash": "edce7d410107864cbc5a7238258f57d5b331ee31f50cd9c29a7d76789aa71499",
  "definition": {
    "Comment": "Project JSONata Step Functions runtime state through a task callback payload",
    "QueryLanguage": "JSONata",
    "StartAt": "Probe",
    "States": {
      "Probe": {
        "Type": "Task",
        "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
        "Arguments": {
          "FunctionName": "arn:aws:lambda:<REDACTED_VAR:REGION>:<REDACTED_VAR:ACCOUNT_ID>:function:tiny-asl-machine-aws-<REDACTED_VAR:WORKSPACE_HASH>-lambda-fixture",
          "Payload": {
            "config": {
              "script": "const sfn = new aws.sfn.SFNClient({}); await sfn.send(new aws.sfn.SendTaskSuccessCommand({ taskToken, output: JSON.stringify({ payload, event, taskTokenVar: taskToken, contextRequestId: context.awsRequestId }) })); return { callbackSent: true };"
            },
            "payload": {
              "input": "{% $states.input %}",
              "context": "{% $states.context %}",
              "inputString": "{% $string($states.input) %}",
              "contextString": "{% $string($states.context) %}"
            },
            "taskToken": "{% $states.context.Task.Token %}"
          }
        },
        "End": true
      }
    }
  },
  "input": {
    "hello": "world",
    "nested": {
      "answer": 42
    }
  },
