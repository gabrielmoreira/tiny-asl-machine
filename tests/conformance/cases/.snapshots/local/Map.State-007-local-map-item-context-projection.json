  "id": "007-local-map-item-context-projection",
  "title": "projects Map item context, execution input, and task token in a local iterator task",
  "group": "Map.State",
  "hash": "78887357c16f32861aa6d79606445e179f082f4fa1a80d9d4d6ca621da99fde3",
  "definition": {
    "StartAt": "Iterate",
    "States": {
      "Iterate": {
        "Type": "Map",
        "ItemsPath": "$.items",
        "Parameters": {
          "index.$": "$$.Map.Item.Index",
          "value.$": "$$.Map.Item.Value",
          "executionInput.$": "$$.Execution.Input"
        },
        "Iterator": {
          "StartAt": "Probe",
          "States": {
            "Probe": {
              "Type": "Task",
              "Resource": "arn:local:map:context-probe",
              "Parameters": {
                "payload.$": "$",
                "taskToken.$": "$$.Task.Token"
              },
              "End": true
            }
          }
        },
        "End": true
      }
    }
  },
