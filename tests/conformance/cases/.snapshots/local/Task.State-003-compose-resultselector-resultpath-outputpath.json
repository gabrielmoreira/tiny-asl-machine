{
  "runner": "local",
  "id": "003-compose-resultselector-resultpath-outputpath",
  "title": "composes ResultSelector, ResultPath, and OutputPath after task invocation",
  "group": "Task.State",
  "hash": "0d65bace9c5f6d954b127dcc628ef76ff9ed6afcccf503a076682472e8739017",
  "definition": {
    "StartAt": "Invoke",
    "States": {
      "Invoke": {
        "Type": "Task",
        "Resource": "local:task:normalize",
        "InputPath": "$.job",
        "Parameters": {
          "jobName.$": "$.name",
          "attempt.$": "$.attempt"
        },
        "ResultSelector": {
          "normalized": {
            "id.$": "$.rawId",
            "score.$": "$.metrics.score"
          },
          "source": "task"
        },
        "ResultPath": "$.task",
        "OutputPath": "$.task.normalized",
        "End": true
      }
    }
  },
  "input": {
    "job": {
      "name": "daily-report",
      "attempt": 3
    },
    "ignored": true
  },
  "result": {
    "output": {
      "id": "job-daily-report",
      "score": 30
    }
  }
