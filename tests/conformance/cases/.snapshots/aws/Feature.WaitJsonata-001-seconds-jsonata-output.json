  "definition": {
    "QueryLanguage": "JSONata",
    "StartAt": "WaitForInputDelay",
    "States": {
      "WaitForInputDelay": {
        "Type": "Wait",
        "Seconds": "{% $states.input.delaySeconds %}",
        "Output": {
          "delay": "{% $states.input.delaySeconds %}",
          "requestId": "{% $states.input.requestId %}"
        },
        "End": true
      }
    }
  },
  "input": {
    "delaySeconds": 0,
    "requestId": "req-wait-seconds"
  },
  "result": {
    "output": {
      "delay": 0,
      "requestId": "req-wait-seconds"
    }
  }
